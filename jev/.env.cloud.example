# Copy to .env on the server. Never commit .env.

# Required on a server. Claude writes the open answers and, by default, also decides every typed choice (which field, which
# option, how good a fit). There is no Claude Code login in a container, so it uses the API, billed to this key.
ANTHROPIC_API_KEY=

# Optional, and cheaper: a key from https://openrouter.ai/keys makes JEV answer the typed choices instead of Claude
# (about 1 cent per 10 applications, against about 5 cents per form with Claude). Leave it empty to use Claude only.
OPENROUTER_API_KEY=

# When the daily run starts, HH:MM in TZ. Set TZ in docker-compose.yml to match.
JEV_DAILY_AT=09:00
# 1 to also run once when the container starts. Leave 0 until a rehearsal has gone well.
JEV_RUN_ON_START=0

# Optional. A Telegram bot, so a form that needs you (a human check, an emailed code) and the day's summary reach your phone.
# Create a bot with @BotFather, then send it a message and read your chat id from https://api.telegram.org/bot<token>/getUpdates
JEV_TELEGRAM_BOT_TOKEN=
JEV_TELEGRAM_CHAT_ID=

# Your files, written into the volume on first start. Each is the file as base64:
#   base64 -w0 profile.json     (on a Mac: base64 -i profile.json)
# A file is written only if it is not already in the volume.
JEV_PROFILE_B64=
JEV_POLICY_B64=
JEV_BANK_B64=
JEV_VOICE_B64=
# Not for the resume: one environment variable is limited to about 128 KB and a PDF can pass it.
# Copy the resume in after the first start (docs/CLOUD.md).
