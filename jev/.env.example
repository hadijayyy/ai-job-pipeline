# Optional. Leave it empty and Claude answers the typed questions (which field, which option, how good a fit): no key to get,
# a few cents more per form. With a key, JEV answers them through OpenRouter: about 1 cent per 10 applications.
# Create one at https://openrouter.ai/keys. JEV_BACKEND=claude keeps Claude even when a key is here.
OPENROUTER_API_KEY=
JEV_BACKEND=

# Optional. Shown on openrouter.ai rankings. Leave blank if you do not care.
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=jev-job-search

# Optional. Claude is reached through Claude Code on your subscription by default.
# Put a Claude API key here instead to call the Claude API directly, billed to this key.
# Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional. "claude-code" keeps Claude Code even when the key above is set.
WRITER_BACKEND=

# Only on a machine without the macOS Keychain: the one password your job-board
# accounts use. On a Mac leave this empty and run `npx jev accounts password`,
# which keeps it in the Keychain.
JEV_ACCOUNTS_PASSWORD=
